# ---------------------------------------------------------------------------
# Copie para .env e ajuste. NUNCA commite o .env (ja esta no .gitignore).
# ---------------------------------------------------------------------------

# --- PostgreSQL (host) ---
# Ao rodar scripts fora do Docker, use a porta publicada pelo docker-compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=gaming_analytics
POSTGRES_USER=gaming
POSTGRES_PASSWORD=gaming

# --- Chaves de API ---
# Steam: NAO e necessaria para a Fase 1 (os endpoints usados sao publicos).
# Fica reservada para endpoints autenticados (ex.: ISteamUser/GetPlayerSummaries).
STEAM_API_KEY=
# Riot (Fase 3 - LoL): https://developer.riotgames.com/
RIOT_API_KEY=
# Valorant nao oficial (Fase 7 - opcional): https://docs.henrikdev.xyz/
VALORANT_API_KEY=
# OpenDota (Fase 2): OPCIONAL. Sem chave sao ~3.000 chamadas/dia, o que basta.
OPENDOTA_API_KEY=

# --- API / dashboard ---
# Origens que o CORS libera (o dashboard React roda em outra porta).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Coleta ---
LOG_LEVEL=INFO
LOG_FORMAT=json                    # json | text
RAW_DATA_DIR=data/raw

# Intervalo minimo entre chamadas (segundos).
# store.steampowered.com e agressivo: ~200 req / 5 min por IP.
STEAM_STORE_RATE_LIMIT_SECONDS=1.5
STEAM_API_RATE_LIMIT_SECONDS=0.5
STEAM_SPY_RATE_LIMIT_SECONDS=1.0
# OpenDota permite 60 req/min; 1.05s da folga para nao tomar 429.
OPENDOTA_RATE_LIMIT_SECONDS=1.05

# cc define a moeda do preco; l=english mantem a data de lancamento parseavel.
# Texto das avaliacoes: quantas por pagina (max 100) e quantas paginas por jogo.
# Cada pagina e uma requisicao no mesmo balde de rate limit do appdetails, entao
# subir PAGINAS multiplica o custo da coleta pelo numero de jogos monitorados.
STEAM_REVIEWS_POR_APP=100
STEAM_REVIEWS_PAGINAS=1

STEAM_COUNTRY=br
STEAM_LANGUAGE=english

# Janela de deduplicacao dos snapshots, em minutos.
# Duas coletas dentro da mesma janela atualizam a MESMA linha (idempotencia).
SNAPSHOT_BUCKET_MINUTES=60

# Agendador de coleta (servico `agendador` do compose), em minutos.
# STEAM=60 acompanha SNAPSHOT_BUCKET_MINUTES: coletar mais rapido que a janela
# so reescreve a mesma linha. OPENDOTA e LIQUIPEDIA sao cortesia com APIs
# publicas - o calendario de campeonato muda em dias, nao em minutos.
AGENDADOR_STEAM_MINUTOS=60
AGENDADOR_OPENDOTA_MINUTOS=360
AGENDADOR_LIQUIPEDIA_MINUTOS=720
# Paginas de equipe da wiki: uma vez por dia basta.
AGENDADOR_EQUIPES_MINUTOS=1440
# Quantas wikis por rodada. As 71 de uma vez passariam de 1h30 de chamadas.
AGENDADOR_EQUIPES_POR_RODADA=10
# Bracket de torneio: historico inteiro, nao so a janela do ticker. Diario.
AGENDADOR_BRACKETS_MINUTOS=1440
AGENDADOR_BRACKETS_POR_RODADA=10
# Ranking da Valve (CS2): um snapshot novo por mes. Semanal ja pega o mes novo.
AGENDADOR_RANKING_MINUTOS=10080
# Preco nas outras lojas (IsThereAnyDeal): promo dura dias, 2x ao dia basta.
AGENDADOR_PRECOS_MINUTOS=720
# Coletar uma vez ao subir, em vez de esperar o primeiro intervalo.
AGENDADOR_RODAR_AO_INICIAR=true

# Assistente de IA. Sem chave, a tela do assistente diz que falta configurar
# e o resto do projeto continua funcionando normalmente.
# Pegue a sua em https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free

# Comparacao de preco (IsThereAnyDeal). Sem chave, o painel "Onde comprar"
# simplesmente nao aparece. Chave gratuita e self-service (sem aprovacao) em:
# https://isthereanydeal.com/apps/my/
ITAD_API_KEY=
ITAD_COUNTRY=BR

# Agenda de partidas (Liquipedia). A politica deles exige gzip e um
# User-Agent que identifique o projeto e um contato - UA generico e motivo
# declarado de bloqueio, e o bloqueio atinge o IP, nao a chave.
LIQUIPEDIA_RATE_LIMIT_SECONDS=3.0
# LIQUIPEDIA_USER_AGENT=SeuProjeto/0.1 (contato@exemplo.com)
